+    #[test]
+    fn qemu_serial_model_accepts_alternating_owners_per_selection() {
+        let (transport, mut host, events) = connect_mode(true);
+        request_capabilities(&mut host);
+        assert!(matches!(
+            events.recv_timeout(Duration::from_secs(2)).unwrap(),
+            TransportEvent::PeerCapabilities(_)
+        ));
+        assert_eq!(read_message(&mut host).0, VD_AGENT_ANNOUNCE_CAPABILITIES);
+
+        // Model QEMU 10.2.4 independently: a host grab sends last_serial++,
+        // while a guest grab is accepted iff serial >= last_serial, then sets
+        // last_serial to that value. The host therefore wins equal-serial
+        // ownership races. Clipboard and primary have independent counters.
+        let mut host_serial = [0u32; 2];
+        for selection in [
+            ClipboardSelection::Clipboard,
+            ClipboardSelection::Clipboard,
+            ClipboardSelection::Primary,
+            ClipboardSelection::Clipboard,
+            ClipboardSelection::Primary,
+        ] {
+            let index = selection.spice_id() as usize;
+            let serial = host_serial[index];
+            host_serial[index] = serial.wrapping_add(1);
+            let mut payload = selection_prefix(selection).to_vec();
+            payload.extend(serial.to_le_bytes());
+            payload.extend(VD_AGENT_CLIPBOARD_UTF8_TEXT.to_le_bytes());
+            host.write_all(&encode_message_frame(VD_AGENT_CLIPBOARD_GRAB, &payload))
+                .unwrap();
+            match events.recv_timeout(Duration::from_secs(2)).unwrap() {
+                TransportEvent::HostGrab {
+                    selection: actual,
+                    serial: actual_serial,
+                    types,
+                } => {
+                    assert_eq!(actual, selection);
+                    assert_eq!(actual_serial, Some(serial));
+                    assert_eq!(
+                        types,
+                        vec![VD_AGENT_CLIPBOARD_UTF8_TEXT],
+                        "host grab, including an equal-serial grab, must not be discarded"
+                    );
+                }
+                other => panic!("expected host grab, got {other:?}"),
+            }
+
+            assert!(transport.send_clipboard_grab_text(selection).unwrap());
+            let (kind, payload) = read_message(&mut host);
+            assert_eq!(kind, VD_AGENT_CLIPBOARD_GRAB);
+            assert_eq!(payload[0], selection.spice_id());
+            let guest_serial = le_u32(&payload[4..8]);
+            assert!(
+                guest_serial >= host_serial[index],
+                "QEMU would discard guest {selection} grab {guest_serial} < {}",
+                host_serial[index]
+            );
+            host_serial[index] = guest_serial;
+        }
+
+        // Keep advancing when an accepted host serial itself reaches MAX.
+        // QEMU post-increments this to zero, so the next guest grab is zero.
+        {
+            let mut state = transport.state.lock().unwrap();
+            state.serial_counter[0] = u32::MAX;
+            state.last_serial[0] = Some(u32::MAX - 1);
+        }
+        let mut payload = selection_prefix(ClipboardSelection::Clipboard).to_vec();
+        payload.extend(u32::MAX.to_le_bytes());
+        payload.extend(VD_AGENT_CLIPBOARD_UTF8_TEXT.to_le_bytes());
+        host.write_all(&encode_message_frame(VD_AGENT_CLIPBOARD_GRAB, &payload))
+            .unwrap();
+        assert!(matches!(
+            events.recv_timeout(Duration::from_secs(2)).unwrap(),
+            TransportEvent::HostGrab { serial: Some(u32::MAX), types, .. }
+                if types == [VD_AGENT_CLIPBOARD_UTF8_TEXT]
+        ));
+        assert!(
+            transport
+                .send_clipboard_grab_text(ClipboardSelection::Clipboard)
+                .unwrap()
+        );
+        let (kind, payload) = read_message(&mut host);
+        assert_eq!(kind, VD_AGENT_CLIPBOARD_GRAB);
+        assert_eq!(le_u32(&payload[4..8]), 0);
+    }
