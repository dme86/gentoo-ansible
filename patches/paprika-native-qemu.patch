+    #[test]
+    fn initial_snapshot_defers_grab_while_capability_reply_is_blocked() {
+        let (transport, mut host, _events) = connect_mode(true);
+        let responder = SpiceTransport {
+            path: transport.path.clone(),
+            writer: Arc::clone(&transport.writer),
+            state: Arc::clone(&transport.state),
+            max_text_bytes: 1024,
+        };
+        let (reply_started, wait_for_reply) = mpsc::channel();
+        let (resume_reply, reply_resumed) = mpsc::channel();
+        let negotiation = thread::spawn(move || {
+            negotiate_capabilities(
+                &responder.state,
+                vec![1 << VD_AGENT_CAP_CLIPBOARD_BY_DEMAND],
+                || {
+                    reply_started.send(()).unwrap();
+                    reply_resumed.recv_timeout(Duration::from_secs(2)).unwrap();
+                    responder.send_capabilities(false)
+                },
+            )
+            .unwrap()
+        });
+        wait_for_reply.recv_timeout(Duration::from_secs(2)).unwrap();
+        // The main loop's initial snapshot does not wait for the readiness
+        // event. This call must defer without waiting on the blocked reply.
+        assert!(
+            !transport
+                .send_clipboard_grab_text(ClipboardSelection::Clipboard)
+                .unwrap()
+        );
+        resume_reply.send(()).unwrap();
+        assert!(negotiation.join().unwrap().clipboard_by_demand);
+        assert!(
+            transport
+                .send_clipboard_grab_text(ClipboardSelection::Clipboard)
+                .unwrap()
+        );
+        assert_eq!(read_message(&mut host).0, VD_AGENT_ANNOUNCE_CAPABILITIES);
+        assert_eq!(read_message(&mut host).0, VD_AGENT_CLIPBOARD_GRAB);
+    }
