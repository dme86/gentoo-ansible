+fn negotiate_capabilities(
+    state: &Mutex<TransportState>,
+    caps: Vec<u32>,
+    reply: impl FnOnce() -> Result<()>,
+) -> Result<PeerCapabilities> {
+    // Initial snapshots and retry timers can send grabs without waiting for a
+    // PeerCapabilities event. Shared readiness must stay false until the host
+    // has our reply too, not merely until that event is emitted.
+    state
+        .lock()
+        .map_err(|_| anyhow!("state mutex poisoned"))?
+        .clipboard_by_demand = false;
+    reply()?;
+
+    let peer = PeerCapabilities {
+        clipboard_by_demand: has_capability(&caps, VD_AGENT_CAP_CLIPBOARD_BY_DEMAND),
+        clipboard_selection: has_capability(&caps, VD_AGENT_CAP_CLIPBOARD_SELECTION),
+        clipboard_grab_serial: has_capability(&caps, VD_AGENT_CAP_CLIPBOARD_GRAB_SERIAL),
+    };
+    let mut guard = state.lock().map_err(|_| anyhow!("state mutex poisoned"))?;
+    guard.peer_caps = caps;
+    guard.clipboard_by_demand = peer.clipboard_by_demand;
+    guard.clipboard_selection = peer.clipboard_selection;
+    guard.clipboard_grab_serial = peer.clipboard_grab_serial;
+    guard.serial_counter = [0; 2];
+    guard.last_serial = [None; 2];
+    debug!(
+        "peer capabilities: clipboard_by_demand={} selection={} grab_serial={}",
+        peer.clipboard_by_demand, peer.clipboard_selection, peer.clipboard_grab_serial
+    );
+    Ok(peer)
+}
