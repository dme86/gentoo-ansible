+    #[test]
+    fn native_qemu_replies_once_before_the_first_clipboard_grab() {
+        use std::io::Read;
+
+        let (transport, mut host, events) = connect_mode(true);
+        // The native backend, unlike a SPICE viewer, initiates negotiation.
+        // No guest announcement may precede its request.
+        host.set_nonblocking(true).unwrap();
+        assert_eq!(
+            host.read(&mut [0u8; 1]).unwrap_err().kind(),
+            io::ErrorKind::WouldBlock
+        );
+        host.set_nonblocking(false).unwrap();
+        request_capabilities(&mut host);
+        assert!(matches!(
+            events.recv_timeout(Duration::from_secs(2)).unwrap(),
+            TransportEvent::PeerCapabilities(_)
+        ));
+
+        // Act on readiness immediately, as the main loop does with a cached
+        // selection. The host must see our reply before that first grab.
+        assert!(
+            transport
+                .send_clipboard_grab_text(ClipboardSelection::Clipboard)
+                .unwrap()
+        );
+        let (kind, payload) = read_message(&mut host);
+        assert_eq!(kind, VD_AGENT_ANNOUNCE_CAPABILITIES);
+        assert_eq!(le_u32(&payload[..4]), 0, "reply must not request a reply");
+        assert!(has_capability(
+            &parse_capabilities(&payload).unwrap(),
+            VD_AGENT_CAP_CLIPBOARD_GRAB_SERIAL
+        ));
+        assert_eq!(read_message(&mut host).0, VD_AGENT_CLIPBOARD_GRAB);
+
+        // Exercise actual clipboard traffic after negotiation, rather than
+        // accepting a connection that only managed to exchange capabilities.
+        let mut request = selection_prefix(ClipboardSelection::Clipboard).to_vec();
+        request.extend(VD_AGENT_CLIPBOARD_UTF8_TEXT.to_le_bytes());
+        host.write_all(&encode_message_frame(VD_AGENT_CLIPBOARD_REQUEST, &request))
+            .unwrap();
+        assert!(matches!(
+            events.recv_timeout(Duration::from_secs(2)).unwrap(),
+            TransportEvent::HostRequest {
+                selection: ClipboardSelection::Clipboard,
+                ..
+            }
+        ));
+        assert!(
+            transport
+                .send_clipboard_text(
+                    ClipboardSelection::Clipboard,
+                    "native QEMU: 界\nsecond line"
+                )
+                .unwrap()
